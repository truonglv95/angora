{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "@angora-js/core": ["./packages/core/src/index.ts"],
      "@angora-js/compiler": ["./packages/compiler/src/index.ts"],
      "@angora-js/runtime": ["./packages/runtime/src/index.ts"],
      "@angora-js/router": ["./packages/router/src/index.ts"],
      "@angora-js/forms": ["./packages/forms/src/index.ts"],
      "@angora-js/http": ["./packages/http/src/index.ts"],
      "@angora-js/server": ["./packages/server/src/index.ts"],
      "@angora-js/vite-plugin": ["./packages/vite-plugin/src/index.ts"],
      "@angora-js/animations": ["./packages/animations/src/index.ts"],
      "@angora-js/testing": ["./packages/testing/src/index.ts"],
      "@angora-js/cli": ["./packages/cli/src/index.ts"],
      "@angora-js/start": ["./packages/start/src/index.ts"],
      "@angora-js/ui": ["./packages/ui/src/index.ts"],
      "@angora-js/devtools": ["./packages/devtools/src/index.ts"],
      "@angora-js/rxjs-interop": ["./packages/rxjs-interop/src/index.ts"],
      "@angora-js/query": ["./packages/query/src/index.ts"],
      "@angora-js/primitives": ["./packages/primitives/src/index.ts"],
      "@angora-js/i18n": ["./packages/i18n/src/index.ts"],
      "@angora-js/create-angora": ["./packages/create-angora/src/index.ts"],
      "@angora-js/prettier-plugin-angora": ["./packages/prettier-plugin-angora/src/index.ts"],
      "@angora-js/eslint-plugin-angora": ["./packages/eslint-plugin-angora/src/index.ts"]
    }
  },

  "exclude": [
    "node_modules",
    "**/node_modules",
    "dist",
    "**/dist",
    "target",
    "**/target",
    ".angora",
    "**/.angora"
  ]
}
