{
  "name": "angora-monorepo",
  "version": "0.1.2",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "benchmarks/*"
  ],
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "build:packages": "bun scripts/build-packages.ts",
    "prepare:packages": "bun scripts/prepare-package-json.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "commitlint": "commitlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "oxlint",
      "oxfmt"
    ],
    "*.{json,scss,md,html}": [
      "oxfmt"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.1",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "sass": "^1.104.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "rxjs": "^7.8.1",
    "prettier": "^3.2.5",
    "eslint": "^9.0.0"
  }
}
